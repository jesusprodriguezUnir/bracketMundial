{
  "name": "bracketmundial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "photos": "node scripts/fetch-ucl-squads.mjs --photos",
    "photo": "node scripts/fetch-ucl-squads.mjs --photos",
    "photos:extract": "node scripts/extract-from-image.mjs",
    "assets:report": "node scripts/fetch-ucl-squads.mjs --report",
    "ucl:squads": "node scripts/fetch-ucl-squads.mjs",
    "ucl:data": "node scripts/fetch-ucl-squads.mjs --data",
    "ucl:photos": "node scripts/fetch-ucl-squads.mjs --photos",
    "ucl:photos:missing": "node scripts/download_missing_tm_photos.mjs",
    "ucl:crests": "node scripts/fetch-ucl-squads.mjs --crests",
    "ucl:report": "node scripts/fetch-ucl-squads.mjs --report",
    "ucl:lineups": "node scripts/fetch-predicted11-lineups.mjs",
    "ucl:injuries": "node scripts/fetch-ucl-injuries.mjs",
    "ucl:stadiums": "node scripts/fetch-ucl-stadiums.mjs",
    "ucl:stadiums:report": "node scripts/fetch-ucl-stadiums.mjs --report",
    "ucl:stadiums:photos": "node scripts/fetch-ucl-stadiums.mjs --photos",
    "ucl:refresh": "node scripts/fetch-predicted11-lineups.mjs --all && node scripts/fetch-ucl-injuries.mjs",
    "guardian": "node scripts/fetch-guardian-squads.mjs",
    "crests": "node scripts/fetch-ucl-squads.mjs --crests",
    "kits": "node scripts/fetch-kits.mjs",
    "pages": "tsx scripts/generate-pages.mjs",
    "previews:build": "node scripts/build-previews.mjs",
    "prebuild": "tsx scripts/generate-pages.mjs && node scripts/generate-icons.mjs && npm run previews:build",
    "build": "tsc && vite build && node scripts/postbuild-seo.mjs",
    "preview": "vite preview",
    "news": "node scripts/ingest-news.mjs",
    "odds": "tsx scripts/generate-odds.mjs",
    "cache:purge:cf": "node scripts/purge-cloudflare-cache.mjs",
    "scores:update": "tsx scripts/update-live-scores.ts",
    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "video": "node scripts/record-video.mjs",
    "video:list": "node scripts/record-video.mjs list",
    "video:all": "node scripts/record-video-all.mjs",
    "video:simulation": "node scripts/record-simulation.mjs",
    "video:leagues": "node scripts/record-leagues.mjs",
    "docs:league-shots": "node scripts/capture-league-guide.mjs",
    "docs:league-shots:en": "node scripts/capture-league-guide.mjs --lang en",
    "record:session": "node scripts/record-session.mjs",
    "simulate": "tsx scripts/simulate-ucl.mjs",
    "reel": "node scripts/record-reel.mjs",
    "reel:simulator": "node scripts/record-reel-simulator.mjs",
    "reel:favorites": "node scripts/generate-favorites-reel.mjs",
    "play:assets": "node scripts/generate-play-assets.mjs",
    "guide:pdf": "tsx scripts/generate-guide-pdf.mjs",
    "x:post": "node scripts/generate-x-post.mjs",
    "youtube:promo": "node scripts/generate-youtube-promo.mjs",
    "db:inspect": "node scripts/supabase-inspect.mjs",
    "db:summary": "node scripts/supabase-summary.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.49.4",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lit": "^3.3.2",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.60.0",
    "@vitest/ui": "^4.1.6",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
