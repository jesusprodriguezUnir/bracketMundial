{
  "name": "bracketmundial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "photos": "node scripts/fetch-squad-assets.mjs",
    "photo": "node scripts/fetch-squad-assets.mjs --type player",
    "photos:extract": "node scripts/extract-from-image.mjs",
    "assets:report": "node scripts/fetch-squad-assets.mjs --report",
    "pages": "tsx scripts/generate-pages.mjs",
    "previews:build": "node scripts/build-previews.mjs",
    "prebuild": "tsx scripts/generate-pages.mjs && node scripts/generate-icons.mjs && npm run previews:build",
    "build": "tsc && vite build && node scripts/postbuild-seo.mjs",
    "preview": "vite preview",
    "news": "node scripts/ingest-news.mjs",
    "odds": "tsx scripts/generate-odds.mjs",
    "scores:update": "tsx scripts/update-live-scores.ts",
    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "video": "node scripts/record-video.mjs",
    "video:list": "node scripts/record-video.mjs list",
    "video:all": "node scripts/record-video-all.mjs",
    "video:simulation": "node scripts/record-simulation.mjs",
    "record:session": "node scripts/record-session.mjs",
    "reel": "node scripts/record-reel.mjs",
    "play:assets": "node scripts/generate-play-assets.mjs",
    "guide:pdf": "node scripts/generate-guide-pdf.mjs",
    "x:post": "node scripts/generate-x-post.mjs",
    "youtube:promo": "node scripts/generate-youtube-promo.mjs",
    "db:inspect": "node scripts/supabase-inspect.mjs",
    "db:summary": "node scripts/supabase-summary.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.49.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lit": "^3.3.2",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.60.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
